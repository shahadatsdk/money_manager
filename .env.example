# Copy to .env and edit. Every value is optional:
# without MYSQL_* the app still writes the JSON activity log and snapshot.

# --- HTTP server ---
PORT=5174
# 0.0.0.0 exposes the app to other devices on the LAN (e.g. your phone)
HOST=0.0.0.0

# --- MySQL mirror (optional) ---
# Set HOST + USER + DATABASE to enable. Tables are created automatically.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=money_manager
MYSQL_POOL_SIZE=5
