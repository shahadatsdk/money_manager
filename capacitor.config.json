{
  "appId": "com.freemoney.manager",
  "appName": "Money Manager",
  "webDir": "frontend",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#f4f5fb",
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#6366f1"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 2000,
      "backgroundColor": "#6366f1",
      "androidSplashResourceName": "splash",
      "showSpinner": true,
      "spinnerColor": "#FFFFFF"
    }
  }
}
